# deploy/docker/gouxiangdb.env — GouXiangDB 容器部署环境变量模板
#
# 用法：
#   cp deploy/docker/gouxiangdb.env.example deploy/docker/gouxiangdb.env
#   填入下列必填项后（本文件含密钥，不要提交 git、不要打进镜像）：
#   docker compose --env-file deploy/docker/gouxiangdb.env \
#     -f deploy/docker/docker-compose.yml up -d --build
#
# 镜像已内置 NODE_ENV=production / PORT=3001 / GX_DATA_DIR=/data /
# UPLOAD_ROOT=/data/uploads / BACKUP_DIR=/data/backups / GX_AUDIT_DIR=/data/log /
# DATABASE_URL=file:/data/app.db / GX_MIGRATIONS_DIR 与 GX_WEB_DIST，无需在此重复。

# ============================ 必填 ============================

# >=16 位随机字符串，禁止任何开发默认值（启动闸门会拉黑并退出码 2）。
# 生成：openssl rand -base64 32
JWT_SECRET=

# 前端来源白名单（逗号分隔；支持 * 通配子域，不要裸 *）。即站点对外域名。
# 浏览器直连回环端口调试时可填 http://localhost:3001。
CORS_ORIGIN=http://localhost:3001

# ============================ 可选 ============================

# 最小可用磁盘（MB）：/readyz 的 disk 探针据此判定，低于则 not ready。
GX_MIN_DISK_MB=1024

# ============ 首次部署：初始超级管理员（可选）============
# 仅首次部署且 users 表为空时生效：entrypoint 在「prisma migrate deploy + nav-reconcile」
# 之后、exec node dist/index.js 之前执行 dist/init-admin.js，创建第一个 ACTIVE 用户、
# 授予系统 owner（role_owner）、标记首次登录强制改密，并写审计事件 admin_initialized。
# 详见 docs/deployment/first-admin-init.md。
#
# 生产必须由部署者在部署时注入真实值——【禁止】把明文密码提交进仓库或打进镜像。
# 本文件含密钥，保持 chmod 600，且不要 commit、不要 ADD 进镜像。
#
# EMAIL 与 PASSWORD 任一为空 -> entrypoint 打印一行提示并正常继续，不会失败：
# 首个通过 /api/auth/signup 注册的用户会自动成为所有者（bootstrapFirstOwnerTx）。
#
# 【初始化完成后建议删除或注释掉这三行】：脚本幂等（users 表已有任何用户即跳过），
# 删掉不会重复创建，可避免凭据长期留在环境文件里。
# GX_INIT_ADMIN_EMAIL=
# GX_INIT_ADMIN_PASSWORD=
# GX_INIT_ADMIN_NAME=超级管理员

# ============ 企业版能力开关（默认开启，除非显式置 off；不写即视为 on）============
# M2 组织管理面（通讯录/部门/角色/成员）；置 off 时整个 /api/v1 组织面与随其挂载的
# MCP 接入面（/mcp、/api/v1/pats）一起摘除（请求 404）。
# GX_ENTERPRISE_ORG=on
# M3 统一导航资源树；置 off 时回退旧导航。
# GX_ENTERPRISE_NAV=on
# 鉴权用户状态缓存 TTL（毫秒），默认 0=旁路缓存、停用/吊销即时生效；>0 时状态变更最多延迟该 TTL。
# GX_AUTH_STATE_TTL_MS=0
# M5 统一检索与上面相反，【默认 off】，需配置向量/全文后再开启；详见 docs/runbooks/m5-search.md。
# GX_M5_SEARCH=off

# ==================== 异地加密备份（默认不启用）====================
# 与 deploy/env.conf.example 同口径：本期仅本地在线快照，异地容灾接口预留、默认全关。
# 确有异地/加密合规需求时再填配置 + 自行在镜像内安装 age + 启用，当前保持全部注释。
# BACKUP_ENCRYPT_OFFSITE=false
# AGE_RECIPIENT=
# AGE_BIN=age
# GX_OFFSITE_TARGET=user@backup-host:/var/backups/gouxiangdb/
