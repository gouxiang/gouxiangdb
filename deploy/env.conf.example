# /etc/gouxiangdb/env.conf — GouXiangDB API 生产环境文件模板
#
# 部署要求：
#   install -m 600 -o gouxiangdb -g gouxiangdb env.conf /etc/gouxiangdb/env.conf
#   即仅属主可读写（600），属主 gouxiangdb；绝不提交仓库、绝不打进发布包。
#   systemd 单元通过 EnvironmentFile=/etc/gouxiangdb/env.conf 加载。
#
# 复制本模板后逐项填值；NODE_ENV=production 时 src/config.ts 会在连接数据库前
# 校验全部必填项，缺失/非法立即退出码 2。

NODE_ENV=production

# 必填：>=16 位随机字符串。生成：openssl rand -base64 32
# 禁止使用任何源码内置开发默认值（会被启动闸门拉黑）。
JWT_SECRET=

# 必填：SQLite 绝对路径
DATABASE_URL=file:/var/lib/gouxiangdb/app.db

# 必填：前端来源白名单（逗号分隔，支持 * 通配）
CORS_ORIGIN=https://gx.example.com

# 可选
PORT=3001
GX_DATA_DIR=/var/lib/gouxiangdb
# UPLOAD_ROOT=/var/lib/gouxiangdb/uploads
GX_MIN_DISK_MB=1024
# GX_AUDIT_DIR=/var/log/gouxiangdb
# BACKUP_DIR=/var/backups/gouxiangdb

# 备份异地加密（S6）：启用时 AGE_RECIPIENT 必填（age X25519 公钥 age1...）；
# identity 私钥离线保管，严禁写入本文件。
# BACKUP_ENCRYPT_OFFSITE=true
# AGE_RECIPIENT=
# GX_OFFSITE_TARGET=
