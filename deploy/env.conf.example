# /etc/gouxiangdb/env.conf — GouXiangDB 生产环境变量模板（M0 S8）
#
# 安全要求：
#   sudo install -m 600 -o gouxiangdb -g gouxiangdb env.conf /etc/gouxiangdb/env.conf
#   即仅属主可读写（600），属主 gouxiangdb；绝不提交仓库、绝不打进发布包。
#   gouxiangdb-api.service 与 gouxiangdb-backup.service 都通过 EnvironmentFile 加载本文件。
#
# 复制本模板后逐项填值。NODE_ENV=production 时 apps/api/src/config.ts 在连接数据库前
# 做 fail-closed 校验，缺失/非法立即退出码 2，不会静默用开发默认值启动。
# systemd EnvironmentFile 语法：KEY=VALUE，行首 # 为注释，值不要加引号（原样传入）。

# ============================ 必填 ============================

NODE_ENV=production

# >=16 位随机字符串。生成：openssl rand -base64 32
# 禁止使用任何源码内置开发默认值（会被启动闸门拉黑）。
JWT_SECRET=

# SQLite 绝对路径（file:/...）。生产必须绝对路径，相对路径在发布后 cwd 不固定会指错库。
DATABASE_URL=file:/var/lib/gouxiangdb/app.db

# 前端来源白名单（逗号分隔；支持 * 通配子域，不要裸 *）。即站点对外域名。
# 例：https://gx.example.com 或 https://gx.example.com,https://gx-intra.example.com
CORS_ORIGIN=https://gx.example.com

# ============================ 基础运行 ============================

# API 监听端口。Caddy 反代到 127.0.0.1:此端口；靠防火墙保证外部不可直连。
PORT=3001

# 对外域名：Caddyfile 用 {$GX_DOMAIN} 读取（可由 caddy 的 systemd 环境注入）。
# 应用本身不读此项，放在此处统一登记；公网正式证书与内网自签的选择见 runbook。
GX_DOMAIN=gx.example.com

# 数据/上传/迁移/审计/备份目录（默认值即裸机标准路径，通常无需改）。
GX_DATA_DIR=/var/lib/gouxiangdb
# UPLOAD_ROOT=/var/lib/gouxiangdb/uploads
# GX_MIGRATIONS_DIR=/srv/gouxiangdb/current/api/prisma/migrations
GX_AUDIT_DIR=/var/log/gouxiangdb
BACKUP_DIR=/var/backups/gouxiangdb

# 最小可用磁盘（MB）：readyz 的 disk 探针据此判定，低于则 not ready。
GX_MIN_DISK_MB=1024

# 请求体上限（MB）：JSON 接口默认 1，上传（头像）默认 6，附件上传默认 40【整包】；
# 与 Caddy request_body 上限双保险（附件整包若在 Caddy 之后放开到 40MB 以上，
# Caddy 侧 request_body 必须同步调大，否则网关先 413）。
# GX_BODY_LIMIT_JSON=1
# GX_BODY_LIMIT_UPLOAD=6
# GX_BODY_LIMIT_ATTACHMENT=40
#
# 附件【单文件】上限（MB）：默认 20，只影响「文件 xxx 超过 20MB 上限」这类提示口径，
# 与整包档分名——调容量改上面那项，别动这项。
# GX_ATTACHMENT_MAX_FILE=20
#
# 备份脚本的 uploads 来源：UPLOAD_ROOT 未设时按 GX_DATA_DIR/uploads 解析（与运行时同口径）。
# 裸机 systemd 备份单元读本文件，保持与 API 单元同一份配置，避免备份漏掉 uploads。

# 限流：默认开启（非 test 环境）。仅在压测等场景显式 GX_RATE_LIMIT=off 关闭。
# GX_RATE_LIMIT=on

# ============================ 首次部署：初始超级管理员（可选）============================
# 仅首次部署且 users 表为空时生效：部署链路在「prisma migrate deploy + nav-reconcile」之后、
# 服务启动之前执行 dist/init-admin.js，用下面三个变量创建第一个 ACTIVE 用户、授予系统
# owner（role_owner）、标记首次登录强制改密，并写审计事件 admin_initialized。
# 详见 docs/deployment/first-admin-init.md。
#
# 生产必须由部署者在部署时注入真实值——【禁止】把明文密码提交进仓库或打进发布包。
# 本文件含密钥，保持仅属主可读写（600）：
#   sudo install -m 600 -o gouxiangdb -g gouxiangdb env.conf /etc/gouxiangdb/env.conf
#
# EMAIL 与 PASSWORD 任一为空 -> 部署链路打印一行提示并正常继续，不会失败：
# 首个通过 /api/auth/signup 注册的用户会自动成为所有者（bootstrapFirstOwnerTx）。
#
# 【初始化完成后建议删除或注释掉这三行】：脚本幂等（users 表已有任何用户即跳过），
# 删掉不会重复创建，可避免凭据长期留在环境文件里。
# GX_INIT_ADMIN_EMAIL=
# GX_INIT_ADMIN_PASSWORD=
# GX_INIT_ADMIN_NAME=超级管理员

# ==================== 企业版能力开关（均默认开启，除非显式置 off）====================
# 这两个开关是"默认 on、显式 =off 摘除"的姿态（apps/api/src/config.ts 判 !== "off"）。
# 出厂模板不设置它们即视为 on；如需关闭某项企业版能力，显式在本文件写 ...=off。
#
# M2 企业组织管理面：通讯录/部门/角色/成员生命周期。置 off 时整个 /api/v1 组织面不挂载（请求 404）。
# GX_ENTERPRISE_ORG=on
# M3 统一导航资源树（菜单/资源树/导航管理）。置 off 时回退到旧的零散导航。
# GX_ENTERPRISE_NAV=on
# 注意：M6 的 MCP 接入面（/mcp 与 /api/v1/pats PAT 管理）随 GX_ENTERPRISE_ORG 一起挂载；
# 关闭 ORG 即同时摘除 MCP 面。MCP 默认无独立开关，访问控制由 PAT 认证 + 可见集闸门两层保证。
#
# 鉴权用户状态缓存 TTL（毫秒）。默认 0 = 完全旁路缓存，每请求对 users 做一次主键点查；
# 停用账号 / 吊销令牌即时生效。仅在确认需要降低点查压力时设 >0，代价是状态变更最多延迟该 TTL 生效。
# 必须为非负整数，非法值启动闸门 fail-closed（退出码 2）。
# GX_AUTH_STATE_TTL_MS=0
#
# M5 统一检索（语义/全文）：与上面两项相反，【默认 off】。仅在完成向量/全文配置后才开启；
# off 时 /api/search 走旧链 LIKE、MCP record.search 工具不注册。详见 docs/runbooks/m5-search.md。
# GX_M5_SEARCH=off
#
# 记录变更历史（数据日志）：记录详情抽屉「查看日志」的数据源，【默认 on】。
# 默认开是因为历史**不可回溯补写**：它记的是写前/写后两份字段快照，关着的每一天都是
# 永久丢失。磁盘吃紧或压测时才显式关成 off（只认精确小写 off / false / 0）；
# 关掉后写路径完全不写 record_changes 表（零额外 IO），读端点仍可用，只是回空列表。
# 写入是**真旁路**：日志侧出错只告警一次并吞掉，绝不会让「保存记录」变成 500。
# GX_RECORD_CHANGES=on

# ============================ 异地加密备份（可选扩展，默认不启用）============================
# 2026-09-12 NAS 重定向（见 docs/planning/phase2/PLAN-ADJUST-nas-min-hardware.md §3，commit 92d0a34）：
#   完整异地容灾（age 加密 + 异地推送 + 定时启用 + 恢复演练）本期＝接口预留，默认不激活。
#   产品默认仅提供【本地在线快照】（手动执行 / 发布前 deploy.sh 自动执行），零额外二进制；
#   gouxiangdb-backup.timer 不随部署自动 enable，需要本地每日定时时由用户手动 systemctl enable --now
#   （该 timer 默认也只做本地快照，不含异地/加密）。
#   以下四个变量是预留的异地投递配置（BackupTransport 契约的 age-rsync 实现样例），
#   未来确有异地/加密合规需求时再填配置 + 装 age + 启用，无需改代码。当前部署请保持全部注释/默认。
#
# 启用 BACKUP_ENCRYPT_OFFSITE=true 时 AGE_RECIPIENT 必填（age X25519 公钥，age1...）。
# age 采用收件人模式：公钥放备份机加密，解密 identity 私钥离线另存，严禁写入本文件或备份机。
# age 不在 PATH 时用 AGE_BIN 指定；本机/目标机缺 age 且开启加密时备份脚本以退出码 3 fail-loud。
# BACKUP_ENCRYPT_OFFSITE=false
# AGE_RECIPIENT=
# AGE_BIN=age
# GX_OFFSITE_TARGET=user@backup-host:/var/backups/gouxiangdb/
