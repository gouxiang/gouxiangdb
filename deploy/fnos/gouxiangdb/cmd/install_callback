#!/bin/bash
# GouXiangDB fnOS 安装回调（应用文件落地后执行）：
#   1) 幂等生成持久配置（TRIM_PKGETC/gouxiangdb.env），首装随机 JWT_SECRET；
#   2) 执行 prisma migrate deploy（只增）。
# 注意：TRIM_DATA_SHARE_PATHS / TRIM_PKGETC 仅在 callback 阶段保证就绪，
#       故初始化不能放 install_init。
set -euo pipefail
export PATH=/var/apps/nodejs_v22/target/bin:$PATH

APP_DIR="${TRIM_APPDEST}/server"
DATA_DIR="${TRIM_DATA_SHARE_PATHS%%:*}"
ENV_FILE="${TRIM_PKGETC}/gouxiangdb.env"

mkdir -p "$DATA_DIR/uploads" "$DATA_DIR/backups" "${TRIM_PKGVAR}/log"

# 1) 持久配置（已存在则保留：升级重装不重生成密钥，避免登录态全失效）。
if [ ! -f "$ENV_FILE" ]; then
  JWT_SECRET="$(node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")"
  # 安装向导若收集 external_origin（无 TRIM_ 前缀）则用作 CORS 来源；
  # 未配置向导时留占位，安装后由用户在 gouxiangdb.env 填实际来源并重启。
  CORS_ORIGIN="${external_origin:-http://localhost}"
  umask 077
  cat > "$ENV_FILE" <<EOF
NODE_ENV=production
JWT_SECRET=${JWT_SECRET}
DATABASE_URL=file:${DATA_DIR}/app.db
CORS_ORIGIN=${CORS_ORIGIN}
PORT=3001
GX_MIN_DISK_MB=1024
# 应用更新机制：内置只读 Gitea 令牌（仅单仓 read 权限）。
# 占位符 __GX_UPDATE_TOKEN__ 由 build-fpk.mjs 在打包副本中替换为真实只读令牌，
# 仓库里的源模板【绝不】写死令牌；升级不重写本文件，轮换走 upgrade_callback 定点刷新。
GX_UPDATE_TOKEN=__GX_UPDATE_TOKEN__
EOF
fi

# 2) 数据库迁移（只允许 migrate deploy）。
cd "$APP_DIR"
# shellcheck disable=SC1090
set -a; source "$ENV_FILE"; set +a
node node_modules/prisma/build/index.js migrate deploy --schema=prisma/schema.prisma \
  || { echo "prisma migrate deploy failed on install" > "$TRIM_TEMP_LOGFILE"; exit 1; }

# M3-S11-A/AC-UPG-1：迁移只给根节点 path，安装迁移后必须全量重算非根节点 path/depth
#（cwd=$APP_DIR 即 server/，dist 布局与裸机 release/api 同构：dist/nav-reconcile.js）。
node dist/nav-reconcile.js --apply \
  || { echo "nav reconcile failed on install" > "$TRIM_TEMP_LOGFILE"; exit 1; }

# 3) 首次部署：创建超级管理员（幂等；users 表已有任何用户则打印"已初始化，跳过"并 exit 0）。
#    必须在 migrate deploy 之后（users 表要存在）、cmd/main start 之前执行。
#    凭据来自 ${ENV_FILE}（上面 set -a; source 已注入本进程环境）；
#    两者任一为空即跳过且不阻断安装——首个通过 /api/auth/signup 注册的用户会自动成为所有者
#    （apps/api/src/domain/org/members.ts 的 bootstrapFirstOwnerTx）。
#    退出码：0=已创建/检测到已初始化而跳过；64=生产环境未提供凭据；1=执行失败。
if [[ -n "${GX_INIT_ADMIN_EMAIL:-}" && -n "${GX_INIT_ADMIN_PASSWORD:-}" ]]; then
  echo "创建初始超级管理员：${GX_INIT_ADMIN_EMAIL}"
  rc=0
  node dist/init-admin.js || rc=$?
  if [[ "$rc" -ne 0 ]]; then
    echo "init-admin failed on install（退出码 ${rc}）：未创建初始超级管理员" > "$TRIM_TEMP_LOGFILE"
    exit 1
  fi
else
  echo "未配置初始管理员凭据，跳过自动初始化（首个通过 /api/auth/signup 注册的用户会自动成为所有者）"
fi

exit 0
