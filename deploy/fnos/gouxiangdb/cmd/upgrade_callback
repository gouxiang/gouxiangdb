#!/bin/bash
# GouXiangDB fnOS 升级回调（新版应用文件落地后执行）：
#   1) 升级前本地在线一致性快照（失败即中止，保护数据）；
#   2) prisma migrate deploy（只增，已应用自动跳过）。
# 回应不回数据：迁移不自动回滚，故先快照；配置 TRIM_PKGETC 与数据 data-share 保留。
set -euo pipefail
export PATH=/var/apps/nodejs_v22/target/bin:$PATH

APP_DIR="${TRIM_APPDEST}/server"
ENV_FILE="${TRIM_PKGETC}/gouxiangdb.env"

[ -f "$ENV_FILE" ] || { echo "Missing $ENV_FILE during upgrade" > "$TRIM_TEMP_LOGFILE"; exit 1; }

# shellcheck disable=SC1090
set -a; source "$ENV_FILE"; set +a
cd "$APP_DIR"

# 1) 发布前在线快照（better-sqlite3 .backup()，零额外二进制）。
if [ -f "scripts/backup/online-backup.mjs" ]; then
  node scripts/backup/online-backup.mjs \
    || { echo "pre-upgrade online backup failed; aborting upgrade" > "$TRIM_TEMP_LOGFILE"; exit 1; }
fi

# 2) 只增迁移。
node node_modules/prisma/build/index.js migrate deploy --schema=prisma/schema.prisma \
  || { echo "prisma migrate deploy failed on upgrade" > "$TRIM_TEMP_LOGFILE"; exit 1; }

# 3) M3-S11-A/AC-UPG-1：迁移后全量重算非根节点 path/depth（cwd=$APP_DIR=server/，
#    dist 与裸机 release/api 同构）。失败即 exit 1，fpk 升级中止、旧版应用不被切换。
node dist/nav-reconcile.js --apply \
  || { echo "nav reconcile failed on upgrade" > "$TRIM_TEMP_LOGFILE"; exit 1; }

exit 0
