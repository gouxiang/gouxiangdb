#!/bin/bash
# GouXiangDB fnOS 升级回调（新版应用文件落地后执行）：
#   0) 应用升级向导 wizard_port：合法且与现 env PORT 不同则定点回写（未收集到则保留现端口）；
#   1) 升级前本地在线一致性快照（失败即中止，保护数据）；
#   2) prisma migrate deploy（只增，已应用自动跳过）；
#   3) nav-reconcile；4) GX_UPDATE_TOKEN 定点轮换（见文件末段）。
# 回应不回数据：迁移不自动回滚，故先快照；配置 TRIM_PKGETC 与数据 data-share 保留。
set -euo pipefail
export PATH=/var/apps/nodejs_v22/target/bin:$PATH

APP_DIR="${TRIM_APPDEST}/server"
ENV_FILE="${TRIM_PKGETC}/gouxiangdb.env"

[ -f "$ENV_FILE" ] || { echo "Missing $ENV_FILE during upgrade" > "$TRIM_TEMP_LOGFILE"; exit 1; }

# 0) 升级向导端口（wizard/upgrade 收集 wizard_port）：
#    0.2.4→0.2.5 升级路径【不读 wizard/install】，若无 wizard/upgrade 则向导值从不收集，
#    app/ui/config 的 ${wizard_port} 会以字面量注册进桌面入口 → 点开白屏、应用设置显示
#    "${wizard_port}"（2026-10-22 真机事故）。升级向导与 install/config 同构收集端口，
#    这里在 source env【之前】定点回写 PORT 行，使后续 main start 直接 source 到新值。
#    - 未收集到（静默升级/老包路径无该字段）：保留现 env PORT，绝不强改老用户端口；
#    - 收集到但非法：exit 1 拒绝升级（官方要求向导值使用前二次校验）；
#    - 与现 PORT 相同：不动文件；
#    - 逐行重建 + 原子 mv，JWT_SECRET / DATABASE_URL / GX_UPDATE_TOKEN 等行逐字保留。
UP_PORT="${wizard_port:-}"
if [ -n "$UP_PORT" ]; then
  if ! [[ "$UP_PORT" =~ ^[0-9]+$ ]] || [ "$UP_PORT" -lt 1024 ] || [ "$UP_PORT" -gt 65535 ]; then
    echo "升级向导服务端口非法：${UP_PORT}（需为 1024-65535 之间的数字），升级已中止，端口与数据均未改动。" > "$TRIM_TEMP_LOGFILE"
    exit 1
  fi
  CUR_UP_PORT="$(node -e '
    const fs=require("fs");
    const p=process.argv[1];
    let v="";
    if(fs.existsSync(p)){for(const l of fs.readFileSync(p,"utf8").split(/\r?\n/)){const m=l.match(/^PORT=(.*)$/);if(m)v=m[1];}}
    process.stdout.write(v.trim());
  ' "$ENV_FILE")"
  if [ "$UP_PORT" != "$CUR_UP_PORT" ]; then
    echo "升级向导：服务端口 ${CUR_UP_PORT:-未设置} → ${UP_PORT}"
    umask 077
    TMP_UP_ENV="$(mktemp "${ENV_FILE}.XXXXXX")"
    node -e '
      const fs=require("fs");
      const [srcFile,dstFile,newPort]=process.argv.slice(1);
      const text=fs.readFileSync(srcFile,"utf8");
      const nl=text.endsWith("\n")?"\n":"";
      const lines=text.split(/\r?\n/);
      if(nl)lines.pop();
      let hit=false;
      const out=lines.map((l)=>{
        if(/^PORT=/.test(l)){hit=true;return "PORT="+newPort;}
        return l;
      });
      if(!hit)out.push("PORT="+newPort);
      fs.writeFileSync(dstFile,out.join("\n")+"\n",{mode:0o600});
    ' "$ENV_FILE" "$TMP_UP_ENV" "$UP_PORT"
    mv "$TMP_UP_ENV" "$ENV_FILE"
  else
    echo "升级向导：服务端口未变化（${CUR_UP_PORT}）"
  fi
else
  echo "升级未收集到 wizard_port（静默升级），保留现服务端口不变。"
fi

# shellcheck disable=SC1090
set -a; source "$ENV_FILE"; set +a
cd "$APP_DIR"

# 1) 发布前在线快照（better-sqlite3 .backup()，零额外二进制）。
if [ -f "scripts/backup/online-backup.mjs" ]; then
  node scripts/backup/online-backup.mjs \
    || { echo "pre-upgrade online backup failed; aborting upgrade" > "$TRIM_TEMP_LOGFILE"; exit 1; }
fi

# 2) 只增迁移。
node node_modules/prisma/build/index.js migrate deploy --schema=prisma/schema.prisma \
  || { echo "prisma migrate deploy failed on upgrade" > "$TRIM_TEMP_LOGFILE"; exit 1; }

# 3) M3-S11-A/AC-UPG-1：迁移后全量重算非根节点 path/depth（cwd=$APP_DIR=server/，
#    dist 与裸机 release/api 同构）。失败即 exit 1，fpk 升级中止、旧版应用不被切换。
node dist/nav-reconcile.js --apply \
  || { echo "nav reconcile failed on upgrade" > "$TRIM_TEMP_LOGFILE"; exit 1; }

# 4) 应用更新只读令牌轮换（设计稿 docs/design/2026-10-app-update/DESIGN.md §8.1 / D1）：
#    首装生成的 gouxiangdb.env 在升级时整体保留（不重写，以免冲掉 JWT_SECRET），
#    故新版内置的只读 Gitea 令牌要在这里【定点】同步进旧 env，只改 GX_UPDATE_TOKEN 一行。
#    - 新令牌取自新包自带的 install_callback 模板（build-fpk.mjs 已把占位符替换成真实令牌）；
#    - 模板里仍是占位符 __GX_UPDATE_TOKEN__ 或为空时跳过（本包未内置令牌，维持现状）；
#    - 与现 env 相同则不动；
#    - 逐行重建 + 临时文件原子 mv，不触碰 JWT_SECRET / DATABASE_URL 等任何其它行。
#
#    ★ install_callback 路径自定位（2026-10-12 真机 0.2.1→0.2.3-rc1 演练抓到的 bug）：
#      fnOS 1.2.0604 真机生命周期脚本落地在 /var/apps/<app>/cmd/，并不在
#      ${TRIM_APPDEST}(=/vol1/@appcenter/<app>)/cmd/ 下（后者在真机不存在）。
#      旧写法只读 ${TRIM_APPDEST}/cmd/install_callback → 文件不存在 → 令牌静默不刷新。
#      改为：优先本脚本同目录（与 install_callback 并列，最可靠），再回退两种历史/他版布局。
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
INSTALL_CB=""
for cand in \
  "${SCRIPT_DIR}/install_callback" \
  "${TRIM_APPDEST}/cmd/install_callback" \
  "/var/apps/${TRIM_APPNAME:-gouxiangdb}/cmd/install_callback"; do
  if [ -f "$cand" ]; then INSTALL_CB="$cand"; break; fi
done
if [ -z "$INSTALL_CB" ]; then
  echo "[upgrade] 未找到 install_callback，跳过 GX_UPDATE_TOKEN 刷新（不影响升级）" > "$TRIM_TEMP_LOGFILE"
fi
NEW_TOKEN=""
if [ -n "$INSTALL_CB" ]; then
  NEW_TOKEN="$(sed -n 's/^GX_UPDATE_TOKEN=//p' "$INSTALL_CB" 2>/dev/null | head -n1 | tr -d '\r' || true)"
fi
if [[ -n "$NEW_TOKEN" && "$NEW_TOKEN" != "__GX_UPDATE_TOKEN__" ]]; then
  CUR_TOKEN="$(node -e '
    const fs=require("fs");
    const p=process.argv[1];
    let v="";
    if(fs.existsSync(p)){for(const l of fs.readFileSync(p,"utf8").split(/\r?\n/)){const m=l.match(/^GX_UPDATE_TOKEN=(.*)$/);if(m)v=m[1];}}
    process.stdout.write(v);
  ' "$ENV_FILE")"
  if [[ "$NEW_TOKEN" != "$CUR_TOKEN" ]]; then
    echo "刷新应用更新只读令牌（GX_UPDATE_TOKEN）"
    umask 077
    TMP_ENV="$(mktemp "${ENV_FILE}.XXXXXX")"
    # 读【现 env】→ 仅替换/追加 GX_UPDATE_TOKEN 一行 → 写临时文件，其它行逐字保留。
    node -e '
      const fs=require("fs");
      const [srcFile,dstFile,newTok]=process.argv.slice(1);
      const text=fs.readFileSync(srcFile,"utf8");
      const nl=text.endsWith("\n")?"\n":"";
      const lines=text.split(/\r?\n/);
      if(nl)lines.pop();
      let hit=false;
      const out=lines.map((l)=>{
        if(/^GX_UPDATE_TOKEN=/.test(l)){hit=true;return "GX_UPDATE_TOKEN="+newTok;}
        return l;
      });
      if(!hit)out.push("GX_UPDATE_TOKEN="+newTok);
      fs.writeFileSync(dstFile,out.join("\n")+"\n",{mode:0o600});
    ' "$ENV_FILE" "$TMP_ENV" "$NEW_TOKEN"
    mv "$TMP_ENV" "$ENV_FILE"
  fi
fi

exit 0
