#!/bin/bash
# GouXiangDB fnOS 生命周期：start/stop/status
#
# 进程以 package 用户（gouxiangdb）运行，监听本机 TCP 端口（默认 3001，
# 由 manifest 的 service_port 声明），对外经 CGI 入口
# /cgi/ThirdParty/gouxiangdb/index.cgi/ 反代（fnOS 先校验 NAS 登录态）。
#
# 为什么不再用统一网关 socket：2026-09-18 在 fnOS 1.2.0604 上实测，
# 声明 gatewayPrefix=/app/gouxiangdb 后访问 http://<nas>:5666/app/gouxiangdb/
# 返回的是门户自己的 "invalid token"，请求没进到应用，桌面点开即空白页；
# 设备上正常工作的三方应用（com.fnos.dashboard）走的是 CGI 反代。详见 app/ui/index.cgi。
#
# 退出码：0 成功/status=运行中；1 失败；3 status=未运行。
set -uo pipefail
export PATH=/var/apps/nodejs_v22/target/bin:$PATH

APP_DIR="${TRIM_APPDEST}/server"
PID_FILE="${TRIM_PKGVAR}/app.pid"
LOG_FILE="${TRIM_PKGVAR}/app.log"
ENV_FILE="${TRIM_PKGETC}/gouxiangdb.env"
DATA_DIR="${TRIM_DATA_SHARE_PATHS%%:*}"

alive() { kill -0 "$1" 2>/dev/null; }

status_app() {
  [ -f "$PID_FILE" ] || return 3
  local pid
  pid="$(head -n1 "$PID_FILE" | tr -d '[:space:]')"
  if [ -n "$pid" ] && alive "$pid"; then return 0; fi
  rm -f "$PID_FILE"
  return 3
}

start_app() {
  if status_app; then exit 0; fi
  mkdir -p "$TRIM_PKGVAR" "$DATA_DIR/uploads" "$DATA_DIR/backups"
  if [ ! -f "$ENV_FILE" ]; then
    echo "Missing $ENV_FILE; reinstall the app to initialize config." > "$TRIM_TEMP_LOGFILE"
    exit 1
  fi
  cd "$APP_DIR" || { echo "server dir missing: $APP_DIR" > "$TRIM_TEMP_LOGFILE"; exit 1; }
  # shellcheck disable=SC1090
  set -a; source "$ENV_FILE"; set +a
  # 监听 TCP（不设 GX_SOCKET_PATH 即走 TCP 分支）：CGI 反代从本机 127.0.0.1:PORT 进来。
  export PORT="${PORT:-3001}"
  # 后端收到的是 CGI 剥离 index.cgi 前缀后的路径（/api/...、/assets/...），
  # 因此【不能】再设 GX_BASE_PATH，否则路由会多期望一层前缀而 404。
  unset GX_BASE_PATH
  export GX_WEB_DIST="$APP_DIR/public"
  export GX_DATA_DIR="$DATA_DIR"
  export UPLOAD_ROOT="$DATA_DIR/uploads"
  export BACKUP_DIR="$DATA_DIR/backups"
  export GX_AUDIT_DIR="${TRIM_PKGVAR}/log"
  export GX_MIGRATIONS_DIR="$APP_DIR/prisma/migrations"
  # 应用更新机制的通道标识（设计稿 docs/design/2026-10-app-update/DESIGN.md §3.4）：
  # node 进程读不到 TRIM_* 变量，必须在此显式声明「我是飞牛 fpk 安装」。
  export GX_DEPLOY_CHANNEL="fnos-fpk"
  node dist/index.js >> "$LOG_FILE" 2>&1 &
  echo "$!" > "$PID_FILE"
}

stop_app() {
  if [ ! -f "$PID_FILE" ]; then exit 0; fi
  local pid
  pid="$(head -n1 "$PID_FILE" | tr -d '[:space:]')"
  if [ -n "$pid" ] && alive "$pid"; then
    kill -TERM "$pid" 2>/dev/null || true
    local i=0
    while alive "$pid" && [ $i -lt 10 ]; do sleep 1; i=$((i+1)); done
    if alive "$pid"; then kill -KILL "$pid" 2>/dev/null || true; fi
  fi
  rm -f "$PID_FILE"
  # 兼容：旧版本用统一网关 socket，卸载升级后清一次残留
  rm -f "${TRIM_APPDEST}/app.sock"
}

case "$1" in
  start)  start_app ;;
  stop)   stop_app ;;
  status) status_app ;;
  *) echo "Unknown command: $1" > "$TRIM_TEMP_LOGFILE"; exit 1 ;;
esac
