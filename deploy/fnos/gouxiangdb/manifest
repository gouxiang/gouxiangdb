appname=gouxiangdb
version=0.1.0
display_name=构想工作台
desc=面向个人与小团队的智能多维表格（SQLite，本地优先）
source=thirdparty
# 架构相关二进制（better-sqlite3 .node + Prisma query engine），禁止 all。
# 构建脚本 build-fpk.mjs 会按 --arch x86|arm 重写本字段。
platform=x86
maintainer=构想工作台团队
distributor=构想工作台团队
os_min_version=1.1.3100
install_dep_apps=nodejs_v22
desktop_uidir=ui
desktop_applaunchname=gouxiangdb.main
# 独立端口服务（0.2.5 起）：应用在自己的 TCP 端口提供服务，桌面门户以跨源 iframe
# 嵌入 http://NAS:${wizard_port}（见 app/ui/config 的 "port":"${wizard_port}"）。
# service_port 仅声明默认端口；实际端口由安装/配置向导 wizard_port 收集并写入 env，
# 故 checkport=false——静态 checkport 只认这里的 3001，对用户自定义端口会漏检/误判，
# 端口占用改由后端 listen 的 EADDRINUSE 兜底报错。
service_port=3001
checkport=false
ctl_stop=true
