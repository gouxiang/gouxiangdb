# ============ 依赖与构建产物 ============
node_modules/
dist/
.vite/
*.tsbuildinfo
# Rust / Tauri 构建产物（保留 src-tauri/icons 等源资源）
**/target/

# ============ 密钥与环境（绝不入库） ============
.env
.env.*
!.env.example

# ============ 数据库与本地备份 ============
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
.db-backups/

# 用户上传与运行时探针文件（绝不入库；部署时由部署脚本建目录）
apps/api/uploads/*
!apps/api/uploads/.gitkeep

# 本地开发态审计 JSONL（生产在 /var/log/gouxiangdb）
apps/api/.audit/
*.logl

# ============ 系统 / 日志 / 临时 ============
.DS_Store
*.log
_tmp_*

# ============ 过程产物（仅本地，不进产品仓） ============
.verify-shots/
.playwright-cli/
.workbuddy-artifacts/
artifacts/
screenshots/

# ============ WorkBuddy 项目记忆 ============
# 规则：知识“文本”随仓走（跨机继承约定/方案/技能/报告），重型二进制与机器本地数据忽略。
# 保留：memory/**/*.md、skills/**/*.md、顶层 *.md 报告
# 忽略：截图、verify 调试产物、临时文本
.workbuddy/verify/
.workbuddy/**/*.png
.workbuddy/**/*.jpg
.workbuddy/**/*.jpeg
.workbuddy/**/*.gif
.workbuddy/**/*.zip
.workbuddy/**/*.log
.workbuddy/**/*.tmp

# ============ S8 裸机发布物（构建机本地产物，由 deploy/bin/package-release.mjs 生成）============
/release/

# ============ 帮助中心同步产物（真源 docs/help-center/_parts/*.md，scripts/sync-help-center.mjs 生成）============
# HELP-CENTER.md 是分片拼接产物、generated/ 是 md 副本、public/help/ 是截图副本；
# 三者都是派生物，改内容请改 _parts/ 真源。
# 注意：docs/help-center/assets/ 是截图专用资源目录（含 .gitkeep），
#       docs/help-center/_parts/ 是正文真源 —— 任何清理脚本都不得清这两个目录。
docs/help-center/HELP-CENTER.md
apps/web/src/features/help/generated/
apps/web/public/help/

# ============ 走查/验收的过程产物（playwright 控制台 dump、错误快照等，非结论文档）============
# 结论一律落在 docs/acceptance/<日期>-<主题>.md；控制台日志与 locator 错误快照不入仓。
docs/acceptance/acceptance-error.json
docs/acceptance/acceptance-logs.json
