# ============ 依赖与构建产物 ============
node_modules/
dist/
# 桌面壳门控构建（VITE_NODE_LAUNCHER=1）的专用前端产物，由 build-web-shell.mjs 重建
apps/web/dist-shell/
.vite/
*.tsbuildinfo
# Rust / Tauri 构建产物（保留 src-tauri/icons 等源资源）
**/target/

# ============ 密钥与环境（绝不入库） ============
.env
.env.*
!.env.example

# ============ 数据库与本地备份 ============
*.db
*.db.bak-*
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
.db-backups/

# 用户上传与运行时探针文件（绝不入库；部署时由部署脚本建目录）
apps/api/uploads/*
!apps/api/uploads/.gitkeep

# 本地开发态审计 JSONL（生产在 /var/log/gouxiangdb）
apps/api/.audit/
*.logl

# ============ 系统 / 日志 / 临时 ============
.DS_Store
*.log
_tmp_*

# ============ 过程产物（仅本地，不进产品仓） ============
.verify-shots/
.playwright-cli/
.workbuddy-artifacts/
artifacts/
screenshots/
.zwork/

# ============ WorkBuddy 内部工作目录（AI 工作日志/本地数据，私有，不进开源仓）============
# 整个目录均为内部协作产物（含内部运维记录），不随开源仓分发。
.workbuddy/

# ============ 在线授权后台（独立私有项目，仅本地嵌套，不属于本开源仓）============
# 见 docs/design/2026-10-license/CLIENT-LICENSE-INTEGRATION.md
license-server/

# ============ S8 裸机发布物（构建机本地产物，由 deploy/bin/package-release.mjs 生成）============
/release/
# 本地暂存的双端安装包与校验值（fpk/dmg/sha256），不进开源仓；发布时直传 Gitea Release
release-artifacts/

# ============ 走查/验收的过程产物（playwright 控制台 dump、错误快照等，非结论文档）============
# 结论一律落在 docs/acceptance/<日期>-<主题>.md；控制台日志与 locator 错误快照不入仓。
docs/acceptance/acceptance-error.json
docs/acceptance/acceptance-logs.json
