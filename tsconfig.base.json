{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@gx/shared-types": ["./packages/shared-types/src/index.ts"],
      "@gx/shared-types/*": ["./packages/shared-types/src/*"],
      "@gx/blocks": ["./packages/blocks/src/index.ts"],
      "@gx/blocks/*": ["./packages/blocks/src/*"],
      "@gx/design-tokens": ["./packages/design-tokens/src/index.ts"],
      "@gx/design-tokens/*": ["./packages/design-tokens/src/*"]
    }
  },
  "exclude": ["**/node_modules", "**/dist", "**/build"]
}