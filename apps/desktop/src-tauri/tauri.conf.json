{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "构想工作台",
  "version": "0.2.5",
  "identifier": "cc.gouxiang.desktop",
  "build": {
    "frontendDist": "../dist-placeholder"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "构想工作台",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "../.stage/gxnode-aarch64-apple-darwin": "gxnode-aarch64-apple-darwin",
      "../.stage/server": "server"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
