// apps/api/prisma/schema.prisma
// v2 数据模型：从 v1 SQLite 1:1 移植到 SQLite
// 设计决策：放弃 v1 "每字段一物理列 c_<fieldId>" 模式
//   改用 JSON 存 records.fields（v2 字段类型系统丰富到 28 种，物理列维护成本太高）
//   字段定义本身存 FieldMeta 表（结构化）
//   link_row 表保留（关联数据存结构化 GXLinkRef）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ Base / 表 ============

model Base {
  id          String   @id @default(cuid())
  name        String
  iconColor   String   @default("#378ADD")
  // 自定义图标名（ENTITY_ICONS 白名单之一）；null = 未自定义，前端按类型渲染默认图标。
  icon        String?
  // 允许分享（库级开关）：关闭时库内任何数据都不能被成员外发链接。
  // 只有对该库持管理权的角色 + 超级管理员 + 管理员能开（domain/authz/libraryPolicy.ts）。
  shareEnabled Int     @default(0)
  createdAt   DateTime @default(now())
  createdBy   String
  deletedAt   DateTime?

  tables      Table[]
  members     Member[]
  shareLinks  ShareLink[]

  // M4/S4：scope creator 兜底 UNION 按 createdBy 点查（迁移 20260916120000 只增索引，EXPLAIN 无 SCAN）。
  @@index([createdBy])
  @@map("bases")
}

model Table {
  id             String   @id @default(cuid())
  baseId         String
  name           String
  primaryFieldId String   // 主显示字段（决定 record 标题）
  // 自定义图标名（ENTITY_ICONS 白名单之一）；null = 未自定义，前端按类型渲染默认图标。
  icon           String?
  // 自定义图标颜色 #RRGGBB；null = 未自定义，前端按类型取默认色。
  iconColor      String?
  // 允许分享（表级开关）：库级开了还不够，表级也得开，成员才能外发这张表的数据。
  shareEnabled   Int      @default(0)
  createdAt      DateTime @default(now())
  createdBy      String
  deletedAt      DateTime?

  base           Base     @relation(fields: [baseId], references: [id], onDelete: Cascade)
  fields         Field[]
  records        Record[]
  views          View[]

  @@index([baseId])
  // M4/S4：scope creator 兜底 UNION（迁移 20260916120000）。
  @@index([createdBy])
  @@map("tables")
}

// ============ Field 元数据 ============

model Field {
  id                String   @id @default(cuid())
  tableId           String
  name              String
  type              String   // FieldType（28 种之一）
  description       String   @default("")
  order             Int
  required          Boolean  @default(false)
  unique            Boolean  @default(false)
  deletedAt         DateTime?

  // Select 选项
  options           String?    // JSON 序列化的 SelectOption[]

  // 文本/字段约束
  maxLength         Int?       // 单行文本最大字数（null 不限制）

  // 日期/日期时间：新建记录时默认填入当前时间
  defaultNow        Boolean    @default(false)

  // 数字/货币
  precision         Int?

  // Rollup/Lookup/Count 筛选条件
  recordFilter      String?    // JSON 序列化的 FilterNode

  // 关联字段
  linkFieldId       String?
  relatedTableId    String?
  relationKind      String?  // mm / hm / bt
  isReverse         Boolean  @default(false)
  reverseFieldId    String?
  linkDisplayFieldId String?

  // Lookup/Rollup
  lookupFieldId     String?
  rollupFunction    String?  // sum / avg / min / max / count

  // Formula
  formula           String?

  // Tabs 选项卡容器（仅 type=tabs）—— JSON 序列化的 TabConfig[]
  tabsConfig        String?

  // Subtable 显示字段列表（仅 type=subtable）—— JSON 序列化的 FieldIdT[]
  // 子表格内嵌表格展示的列
  displayedFieldIds String?

  // Subtable「选择数据」弹窗可见字段列表（仅 type=subtable）—— JSON 序列化的 FieldIdT[]
  // 与 displayedFieldIds 独立；为空时回退默认列。公式引用不受二者限制。
  visibleFieldIds   String?

  // 字段默认内容配置 —— JSON 序列化的 DefaultConfig（static/lookup/formula 三态）
  defaultConfig     String?

  // 自动编号规则（仅 type=autoNumber）—— JSON 序列化的 NumberRule
  numberRule        String?

  table             Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tableId])
  @@index([linkFieldId])
  @@index([reverseFieldId])
  @@map("fields")
}

// ============ Record 数据 ============

model Record {
  id          String   @id @default(cuid())
  tableId     String
  fields      String   // JSON 序列化的 FieldValue map（key = fieldId）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String
  updatedBy   String
  deletedAt   DateTime?

  table       Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  outboundLinks  LinkRow[] @relation("parentRow")
  inboundLinks   LinkRow[] @relation("childRow")

  @@index([tableId])
  @@index([createdAt])
  @@map("records")
}

// ============ 关联数据 ============

model LinkRow {
  id            String   @id @default(cuid())
  linkFieldId   String
  parentRowId   String
  childRowId    String
  ord           Int      @default(0)
  createdAt     DateTime @default(now())
  // 软删：删除记录时只标记，不清行；从回收站恢复记录时关联关系随之恢复
  deletedAt     DateTime?

  parentRow     Record   @relation("parentRow", fields: [parentRowId], references: [id], onDelete: Cascade)
  childRow      Record   @relation("childRow", fields: [childRowId], references: [id], onDelete: Cascade)

  @@unique([linkFieldId, parentRowId, childRowId])
  @@index([linkFieldId, parentRowId])
  @@index([linkFieldId, childRowId])
  @@map("link_rows")
}

// ============ View ============

model View {
  id        String   @id @default(cuid())
  tableId   String
  name      String
  type      String   // grid / gallery / form / detail / kanban / calendar
  lockMode  String   @default("collaborative")
  order     Int
  config    String   // JSON 序列化的 ViewConfig
  adminConfig String? // 管理员配置层 JSON（ViewAdminConfig）；null=无管理员配置
  createdAt DateTime @default(now())

  table     Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)

  // #561：视图的每用户使用态覆盖（view_user_prefs.viewId ON DELETE CASCADE）。
  viewUserPrefs ViewUserPref[]

  @@index([tableId])
  @@map("views")
}

// 表单设计器布局版本：每次保存布局自动留快照（label=null），回退前可手动留档（label 非 null）。
// snapshot 存信封 JSON（{ version, layout, tabs }，见 src/domain/formLayoutVersion.ts）。
// 物理表由手写迁移 20260924010000_form_layout_versions 建立，列/索引与本 model 一一对应。
// 不加物理外键：view_id 为软引用（视图删除由应用层在 views.delete 处 deleteMany 清理）。
model FormLayoutVersion {
  id        String   @id @default(cuid())
  viewId    String
  version   Int
  label     String?
  snapshot  String
  createdBy String
  createdAt DateTime @default(now())

  @@unique([viewId, version])
  @@index([viewId])
  @@map("form_layout_versions")
}

// #561：视图每用户使用态覆盖。prefs 存 ViewUserPrefs JSON（排序/筛选/分组/行高/搜索/聚合等），
// 仅覆盖使用态，不覆盖字段范围/顺序/封面/卡片/详情。每 (viewId,userId) 唯一行，无行即跟随默认。
// 物理表由手写迁移 <ts>_view_user_prefs 建立，列/索引与本 model 一一对应。
model ViewUserPref {
  id        String   @id @default(cuid())
  viewId    String
  userId    String
  prefs     String
  updatedAt DateTime @updatedAt

  view      View     @relation(fields: [viewId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([viewId, userId])
  @@index([viewId])
  @@map("view_user_prefs")
}

// ============ Member & RBAC ============

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  displayName String
  passwordHash String
  username    String?  @unique
  phone       String?
  avatarUrl   String?
  bio         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime?  @updatedAt

  // M2 组织通讯录（迁移 20260915090000_enterprise_org_ddl 只增加列）：
  //  - status 账号生命周期 INVITED/ACTIVE/DISABLED，存量行默认 ACTIVE。
  //  - tokenVersion 鉴权即时失效版本号，JWT 的 tv claim 与之比对，默认 0。
  //  - workspaceId 归属工作区；SQLite ALTER ADD COLUMN 不能附带 REFERENCES，
  //    故【只加列不建 Prisma 关系/FK】，引用完整性由应用层保证（计划 §11-11）。
  //  - disabledAt/inviteTokenHash/invitedAt 停用与邀请一次性激活链接所用；
  //    lastSeenAt 无消费方，不建（YAGNI）。
  //  - mustChangePassword：首次部署由 init-admin 脚本创建的超级管理员置 true，登录后被
  //    middleware/mustChangePassword.ts 的改密闸门拦截（白名单外一律 403）；改密成功后
  //    置 false 解除。存量行默认 false，普通注册/邀请账号不受影响。
  status          String    @default("ACTIVE")
  workspaceId     String?
  tokenVersion    Int       @default(0)
  // 首次部署由 init-admin 创建的超级管理员置 true：登录后被强制改密闸门拦截，
  // 改密成功后清除（见 src/middleware/mustChangePassword.ts 与 auth.ts change-password）。
  mustChangePassword Boolean @default(false)
  disabledAt      DateTime?
  inviteTokenHash String?
  invitedAt       DateTime?

  memberships  Member[]
  kbMemberships KbMember[]
  kbDocAcls    KbDocAcl[]
  comments     Comment[]
  // M2：用户的多部门归属（dept_members.userId 对 users(id) ON DELETE CASCADE）。
  deptMemberships DeptMember[]
  // M6/S1：个人访问令牌（personal_access_tokens.userId 对 users(id) ON DELETE CASCADE，
  // 删除用户级联清 PAT；停用用户走 lifecycle.disableUser 同事务批量吊销，见 §5.1/C-4）。
  personalAccessTokens PersonalAccessToken[]
  // #561：用户的视图个性化覆盖（view_user_prefs.userId ON DELETE CASCADE，删用户级联清理）。
  viewUserPrefs ViewUserPref[]

  @@index([workspaceId])
  @@index([status])
  @@map("users")
}

model Member {
  id         String   @id @default(cuid())
  baseId     String
  userId     String
  role       String   // owner / creator / editor / commenter / viewer
  joinedAt   DateTime @default(now())

  base       Base     @relation(fields: [baseId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([baseId, userId])
  @@index([userId])
  @@map("members")
}

model Comment {
  id        String   @id @default(cuid())
  recordId  String
  userId    String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([recordId])
  @@map("comments")
}

// ============ Share ============

model ShareLink {
  id        String    @id @default(cuid())
  baseId    String
  token     String    @unique
  role      String    // editor / commenter / viewer（不允许分享成 owner）
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  // 分享对象（迁移 20260922010000_share_link_objects 只增列，存量行回落 base）：
  //   objectType = base   —— 整个数据表库（objectId 为空）
  //   objectType = table  —— 某张数据表，objectId=tableId，可选 viewId 锚定视图
  //   objectType = kb_doc —— 知识库文档/画布，objectId=docId（baseId 沿用所在库占位）
  // 文档/画布的分享令牌历史落在 kb_docs.share_token 上，两种令牌由
  // domain/share/shareLinkLookup.ts 统一解析，互不影响。
  objectType String   @default("base")
  objectId   String?
  viewId     String?
  // 分享档位：view=只读 / edit=可编辑。edit 只在创建时要求分享人本人有编辑权，
  // 且每次访问按分享人当前权限重算（见 domain/share/shareCaps.ts），不是一次性判定。
  mode       String   @default("view")
  // 分享人：可编辑链接的动态降级以他当前的库权限为准；为空的存量链接一律只读。
  createdBy  String?

  base      Base      @relation(fields: [baseId], references: [id], onDelete: Cascade)

  @@index([baseId])
  @@index([objectType, objectId])
  @@map("share_links")
}

// ============ 知识库（与 Base/Table 完全解耦的独立容器） ============

model KnowledgeBase {
  id        String   @id @default(cuid())
  name      String
  iconColor String   @default("#0F6E56")
  // 自定义图标名（ENTITY_ICONS 白名单之一）；null = 未自定义，前端按类型渲染默认图标。
  icon      String?
  // 允许分享（库级开关）：同 Base.shareEnabled，作用于文档与画布。
  shareEnabled Int   @default(0)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  members   KbMember[]
  docs      KbDoc[]

  // M4/S4：scope creator 兜底 UNION（迁移 20260916120000）。
  @@index([createdBy])
  @@map("knowledge_bases")
}

model KbMember {
  id      String   @id @default(cuid())
  kbId    String
  userId  String
  role    String   // owner / editor / commenter / viewer
  joinedAt DateTime @default(now())

  kb      KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade)
  user    User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([kbId, userId])
  @@index([userId])
  @@map("kb_members")
}

model KbDoc {
  id          String   @id @default(cuid())
  kbId        String
  kind        String   // "doc"（Markdown 文档） | "canvas"（Drawnix 画布）
  title       String
  content     String   @default("") // doc=Markdown 正文；canvas=Drawnix PlaitElement[] JSON
  searchText  String   @default("") // 冗余纯文本：md 去标记 / 画布节点文本，供 LIKE 全文检索
  // 乐观锁：PUT content 携带 baseVersion 条件更新，冲突返回 409（防多窗口/多人 lost update）
  contentVersion Int   @default(0)
  // 自定义图标名（ENTITY_ICONS 白名单之一）；null = 未自定义，前端按 kind 渲染默认图标。
  icon        String?
  // 自定义图标颜色 #RRGGBB；null = 未自定义，前端按 kind 取默认色。
  iconColor   String?
  createdBy   String
  updatedBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  deletedBy   String?

  // 多文档级联：父文档 id；null = 顶级。应用层维护树完整性（同库 / 非循环）。
  parentId    String?

  // 外链分享
  shareEnabled        Boolean @default(false)
  shareToken          String? @unique // 开启时生成；关闭置空（旧链接立即失效）
  shareRole           String  @default("viewer") // viewer(仅可见) | editor(可编辑)
  shareIncludeChildren Boolean @default(false) // 级联分享：本级及整棵子树一并可外链访问
  // 开分享的人（迁移 20260922010000_share_link_objects 只增列）。
  // 可编辑分享的动态降级按【他当前】的库权限重算：他失去编辑权，链接当次回落只读。
  // 存量行无值 -> 一律按只读处理（不凭空给写权限）。
  shareCreatedBy      String?

  kb          KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade)
  versions    KbDocVersion[]
  acls        KbDocAcl[]

  @@index([kbId])
  @@index([kbId, kind])
  @@index([kbId, parentId])
  @@index([shareToken])
  // M4/S4：scope creator 兜底 UNION（迁移 20260916120000）。
  @@index([createdBy])
  @@map("kb_docs")
}

model KbDocVersion {
  id        String   @id @default(cuid())
  docId     String
  version   Int
  label     String?  // 手动版本备注；null = 自动快照
  title     String
  content   String
  searchText String  @default("")
  createdBy String
  createdAt DateTime @default(now())

  doc       KbDoc    @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@unique([docId, version])
  @@index([docId])
  @@map("kb_doc_versions")
}

/// 单文档/画布独立权限（叠加在知识库成员角色之上）
model KbDocAcl {
  id      String @id @default(cuid())
  docId   String
  userId  String
  role    String // editor / commenter / viewer

  doc     KbDoc  @relation(fields: [docId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([docId, userId])
  @@index([docId])
  @@map("kb_doc_acls")
}

// ============================================================================
// M2 组织通讯录（工作区 / 部门树 / 成员多部门 / 组织角色 / 角色授予）
// 单工作区交付：工作区与五枚系统角色用固定 id（ws_default / role_owner...），
// 多工作区为 Out-of-Scope，users.workspaceId 只留列不建关系。
// 两个索引无法在 Prisma schema 表达、由手写迁移承载（禁止 migrate dev 据其生成变更）：
//   - dept_members 一人一主部门的【部分唯一索引】(userId) WHERE isMain=1；
//   - role_assignments 业务唯一用 COALESCE(scopeNodeId,'') 的【表达式唯一索引】
//     （SQLite 唯一索引把 NULL 视为互不相等，需 COALESCE 归一）。
// ============================================================================

model Workspace {
  id            String       @id
  name          String       @default("默认工作区")
  policyVersion Int          @default(0)
  // M3 统一导航资源树（迁移 20260916090000_enterprise_nav_ddl 只增两列）：
  // nav_nodes/menu_items 各自写事务 bump 对应版本；M3 无缓存消费者，为 M4/前端失效留口。
  navVersion    Int          @default(0)
  menuVersion   Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime?    @updatedAt

  departments   Department[]
  roles         Role[]
  navNodes      NavNode[]
  menuItems     MenuItem[]

  @@map("workspaces")
}

// ============================================================================
// 权限核心模型（二）：角色 × 库 的库权限段（role_library_scope）
//   每行 = 一个角色对一个库（base 或 kb，用 libraryKind 区分）的一条视野授权。
//   与通讯录段（roles.permissions）分开：库权限是二维的（库 × 表 × 字段），
//   塞进一维数组会退化成无法寻址的字符串黑魔法。
//   刻意不复用 auth_policies：那套带着"配了不生效"的未启用引擎语义，
//   复用等于把"为什么这条策略没起作用"的坑再买一次。
//   roleId 不建 Prisma 关系/FK：角色是软删（deletedAt），不需要也不该有级联。
//   硬规则（删库/建库/分享只读）不落本表，一律在 domain/authz/libraryPolicy.ts 现算。
// ============================================================================

model RoleLibraryScope {
  id          String   @id @default(cuid())
  roleId      String
  libraryKind String   // "base" | "kb"
  libraryId   String
  // 1 = 该角色在这个库里持管理权（改结构/改数据/开分享），不含删库。
  canManage   Int      @default(0)
  // 1 = 该角色能进这个库。只勾可见不做逐表设置 = 该库全部表只读。
  visible     Int      @default(0)
  // 1 = 该角色可以把这个库的内容分享出去；独立于 canManage，canManage=1 时依旧隐式有效。
  // 拆出来的原因：分享权是"能不能把东西放行到组织外"，比"能不能改结构"更敏感，
  // 现实里需要"让他管数据但不许他往外发"这种组合（反过来 canManage=1 时仍照旧能开分享，
  // 避免存量授权在升级后静默收权）。
  canShare    Int      @default(0)
  // JSON.stringify(LibraryScopeConfig)：逐表增删改查勾选 + 逐字段 仅可见/可编辑/隐藏。
  config      String   @default("{\"tables\":{},\"fields\":{}}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([roleId, libraryKind, libraryId])
  @@index([roleId])
  @@index([libraryKind, libraryId])
  @@map("role_library_scope")
}

model Department {
  id          String    @id @default(cuid())
  workspaceId String
  parentId    String?
  path        String
  name        String
  ord         Int       @default(0)
  status      String    @default("active")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
  deletedAt   DateTime?

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent      Department? @relation("DeptParent", fields: [parentId], references: [id], onDelete: Restrict)
  children    Department[] @relation("DeptParent")
  members     DeptMember[]

  @@index([workspaceId, parentId])
  @@index([path])
  @@map("departments")
}

model DeptMember {
  id           String    @id @default(cuid())
  departmentId String
  userId       String
  isMain       Int       @default(0) // 1=主部门（部分唯一索引保证一人一主），0=兼岗
  joinedAt     DateTime  @default(now())

  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([departmentId, userId])
  @@index([userId])
  @@map("dept_members")
}

model Role {
  id          String    @id
  workspaceId String
  systemKey   String? // owner/creator/editor/commenter/viewer；自定义角色为 null
  name        String
  description String    @default("")
  isSystem    Int       @default(0) // 1=系统种子行，由迁移拥有（不等价于不可变更）
  // immutable=1：连名称/说明都不许改、不许删。与 isSystem 分离——
  // 三枚权限预设中只有超级管理员（role_owner）immutable=1，管理员/受限成员可删可改。
  immutable   Int       @default(0)
  permissions String    @default("[]") // JSON 字符串数组，组织管理动作（含通讯录十二枚）
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignments RoleAssignment[]

  @@unique([workspaceId, name])
  @@unique([workspaceId, systemKey])
  @@map("roles")
}

model RoleAssignment {
  id          String   @id @default(cuid())
  roleId      String
  subjectType String // "user" | "dept"（多态主体，不建 Prisma 关系/FK）
  subjectId   String
  scopeType   String   @default("workspace") // M2 恒 workspace；node 预留
  scopeNodeId String?
  createdAt   DateTime @default(now())
  createdBy   String?

  role        Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([subjectType, subjectId])
  @@map("role_assignments")
}

// ============================================================================
// M3 统一导航资源树（迁移 20260916090000_enterprise_nav_ddl / *_backfill）
//   - nav_nodes 权威实体树（parentId 真相 + path 物化派生，规则同 departments）；
//   - menu_items 引用编排层（shortcut.nodeId 可重复，RESTRICT FK）；
//   - auth_policies M3 冻结结构、全里程碑无业务读写，M4 才启用。
// nav_nodes 与六张实体表之间刻意不建关系/FK（实体表无 workspaceId 且删除语义不一），
// 引用完整性由 domain/nav/sync.ts 同事务原语 + reconcile-nav 脚本应用层保证。
// ============================================================================

model NavNode {
  id               String    @id @default(cuid())
  workspaceId      String
  parentId         String?
  kind             String // base | kb | table | view | doc | canvas | group
  resourceType     String? // 资源节点同 kind；group 为 null
  resourceId       String?
  name             String
  ord              Int       @default(0)
  path             String    @default("")
  depth            Int       @default(0)
  isSystem         Int       @default(1) // 1=实体自动节点；0=管理员 group
  config           String?
  iconName         String?
  inheritAncestors Int       @default(1) // M3 恒 1，M4 才可置 0
  createdAt        DateTime  @default(now())
  updatedAt        DateTime? @updatedAt
  deletedAt        DateTime?

  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent           NavNode?  @relation("NavNodeTree", fields: [parentId], references: [id], onDelete: Restrict)
  children         NavNode[] @relation("NavNodeTree")
  shortcuts        MenuItem[]

  @@unique([workspaceId, resourceType, resourceId])
  @@index([workspaceId, parentId])
  @@index([workspaceId, kind])
  @@index([resourceType, resourceId])
  @@index([path])
  @@map("nav_nodes")
}

model MenuItem {
  id           String    @id @default(cuid())
  workspaceId  String
  parentId     String?
  type         String // container | shortcut
  nodeId       String? // shortcut -> nav_nodes.id（不唯一，可多处引用）；container 为 null
  label        String?
  iconName     String?
  ord          Int       @default(0)
  brokenReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime? @updatedAt
  deletedAt    DateTime?

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent       MenuItem? @relation("MenuTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     MenuItem[] @relation("MenuTree")
  node         NavNode?  @relation(fields: [nodeId], references: [id], onDelete: Restrict)

  @@index([workspaceId, parentId])
  @@index([nodeId])
  @@map("menu_items")
}

// M3 冻结、M4 启用：禁止在 M3 的业务代码里读写本表（有特征测试锁定表存在但为空）。
model AuthPolicy {
  id          String   @id @default(cuid())
  workspaceId String
  nodeId      String
  subjectType String // user | dept | role
  subjectId   String
  actions     String   @default("r")
  fieldMask   String?
  conditions  String?
  reason      String?
  createdAt   DateTime @default(now())
  createdBy   String

  @@unique([nodeId, subjectType, subjectId])
  @@index([workspaceId, subjectType, subjectId])
  @@index([nodeId])
  @@map("auth_policies")
}

// M5/S1：统一检索 outbox（主库 change_events，手写迁移 20260916140000）。
// 业务写事务内 enqueueChangeEventTx 合并去重写入；由 S5 indexer worker 认领消费。
// 本表与实体不建 FK（可重建事件流，删除不影响旧功能）；workspaceId 单工作区恒 ws_default。
model ChangeEvent {
  id          String    @id @default(cuid())
  entityType  String // record | doc | canvas
  entityId    String
  workspaceId String    @default("ws_default")
  // 用 BigInt（SQLite INTEGER 动态 64 位）：record 版本取 Date.now() 毫秒（13 位 > Int 上限）。
  version     BigInt // doc=contentVersion；record=同事务 Date.now() ms 单调序号
  op          String // upsert | delete
  status      String    @default("pending") // pending|processing|done|failed|dead
  attempts    Int       @default(0)
  workerId    String?
  lastError   String?
  nextRunAt   DateTime  @default(now())
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([status, nextRunAt])
  @@index([entityType, entityId])
  @@map("change_events")
}

// M5/S1：手工 KV 配置表（手写迁移 20260916140000）。S1 只建表不读不写；
// S4 起存 cloud embedding 配置/加密凭据（AES-256-GCM），见 M5 计划 §4.4。
model AppSetting {
  k         String   @id
  v         String
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

// ---------------------------------------------------------------------------
// M6/S1：鉴权 MCP 服务 — 个人访问令牌（PAT）
// 迁移 20260918090000_mcp_pat_ddl（手写只增）。随机段不入库、只存 sha256（@unique 等值查）；
// tokenPrefix 仅明文前 14 字符（含 gxpat_ 前缀）供列表辨识，【不可认证】（C-3 定稿）；
// revokedAt 用时间戳（非 boolean，revoked = revokedAt != null）；expiresAt null=永不过期（C-3）。
// ---------------------------------------------------------------------------
model PersonalAccessToken {
  id          String    @id @default(cuid())
  userId      String
  name        String
  tokenPrefix String
  tokenHash   String    @unique
  scopes      String    // JSON 数组字符串（SQLite 无原生数组）
  expiresAt   DateTime?
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("personal_access_tokens")
}

// ---------------------------------------------------------------------------
// M6/S7 用：MCP 写工具 requestId 幂等轻表（C-8 定稿落库，不用进程内 Map）。
// 键 = key（patId + tool + requestId 的组合串）；24h 窗，过期行不清理也无害（runbook 定期 DELETE）。
// S1 随 PAT 同批建表（§5.1）；表本身在本片无读写方。
// ---------------------------------------------------------------------------
model McpIdempotency {
  key          String   @id
  patId        String
  tool         String
  responseJson String
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@map("mcp_idempotency")
}

// ---------------------------------------------------------------------------
// autoNumber 持久化高水位计数器：counter 段每认领一个序号 value+1，只增不复用，
// 软删记录不再导致重号。key 按「编号字段:段索引:重置方式:桶」区分，多 counter 段独立。
// 建表迁移 migrations/20260925010000_auto_number_counters；
// 存量活记录高水位用 scripts/backfill-auto-number-counters.mjs 幂等回填。
// ---------------------------------------------------------------------------
model AutoNumberCounter {
  id      String @id @default(cuid())
  tableId String
  key     String
  value   Int    @default(0)

  @@unique([tableId, key])
  @@index([tableId])
  @@map("auto_number_counters")
}

// ---------------------------------------------------------------------------
// 附件（R2 附件外置，ARCH-production.md §5.1）：服务端上传落盘后的元数据行。
// 纯增量新表：不动 records/fields 任何既有结构，也不改写存量 dataURL 附件
// （存量 base64 保持原样，前端照旧渲染；本次不做一次性迁移）。
//
// 文件落盘路径 <uploadRoot>/attachments/<yyyy>/<mm>/<sha256>.<ext>，按内容 sha256
// 在同 base 内去重（同内容复用同一行，storagePath 因此可能跨行共享，删除时须计数）。
// storagePath 是相对 uploadRoot 的相对路径，下载端只信库里的值，绝不接收用户路径。
//
// 建表迁移 migrations/20261009010000_attachments（手写只增，列名 camelCase）。
// ---------------------------------------------------------------------------
model Attachment {
  id          String    @id @default(cuid())
  baseId      String
  tableId     String?
  fieldId     String?
  recordId    String?
  name        String
  mime        String
  size        Int
  sha256      String
  storagePath String
  uploaderId  String?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  @@index([sha256])
  @@index([baseId])
  @@index([recordId])
  @@map("attachments")
}

