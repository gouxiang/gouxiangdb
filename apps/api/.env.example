# GouXiangDB v2 API 环境变量样例
# 用法：复制为 apps/api/.env（.env 已被 .gitignore 忽略，不会提交），按需填值。
#   cp apps/api/.env.example apps/api/.env

# SQLite 数据库连接串。
# 相对路径相对 prisma/schema.prisma 所在目录解析（即本 prisma/ 目录），换机/改名都不受影响：
DATABASE_URL="file:./dev.db"

# JWT 签名密钥。
# - 本地开发可留空，代码会回落到仅 dev 的固定密钥（见 src/auth.ts）。
# - 生产（NODE_ENV=production）必须显式提供 >=16 位的随机字符串，否则服务拒绝启动。
#   生成示例：openssl rand -base64 32
JWT_SECRET=""

# API 监听端口（默认 3001）
PORT=3001

# 运行环境：development | production | test
NODE_ENV="development"

# 允许跨域来源（本地开发默认放行 Web 的 5173；生产填实际域名，多个用逗号分隔）
# CORS_ORIGIN="http://localhost:5173"

# 测试/脚本用：置 1 时仅初始化路由不监听端口（普通开发无需设置）
# GX_NO_LISTEN=0
