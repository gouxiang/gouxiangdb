# GouXiangDB v2 API 环境变量样例
#
# 安全约定：
#   - apps/api/.env 仅用于本地开发，已被 .gitignore 忽略，绝不提交、绝不进发布包；
#     生产环境用 systemd EnvironmentFile（/etc/gouxiangdb/env.conf，权限 600、属主 gouxiangdb）。
#   - NODE_ENV=production 时，src/config.ts 启动闸门先于数据库连接求值：
#     任何必填项缺失或使用被拉黑的开发默认密钥，进程立即以退出码 2 终止，不监听端口、不连库。
#
# 用法：cp apps/api/.env.example apps/api/.env

# ── 运行环境（必填）──────────────────────────────────────────────
# development | production | test
# vitest 下自动为 test，闸门全放行；生产必须显式 production。
NODE_ENV="development"

# ── JWT 签名密钥（生产必填）──────────────────────────────────────
# - 本地开发留空时回落到源码内置开发密钥（仅 dev/test，生产拒绝该值）。
# - 生产必填，至少 16 位随机字符串；以下两个历史开发默认值已被拉黑，生产出现即拒绝启动：
#     dev-secret-change-me-in-production
#     dev-secret-change-in-prod-gouxiangdb-v2
# - 生成示例：openssl rand -base64 32
JWT_SECRET=""

# ── 数据库（生产必填且必须为绝对路径）────────────────────────────
# SQLite 连接串，仅支持 file: 前缀。
# 开发：相对路径相对 prisma/schema.prisma 所在目录解析（即 prisma/）。
# 生产：必须绝对路径，如 file:/var/lib/gouxiangdb/app.db（发布后 cwd 不固定）。
DATABASE_URL="file:./dev.db"

# ── 跨域（生产必填）──────────────────────────────────────────────
# 逗号分隔的前端来源白名单，支持 * 通配；不允许生产裸放行。
# 本地开发留空即放行 http://localhost:* 与 http://127.0.0.1:*。
# 生产示例：CORS_ORIGIN="https://gx.example.com"
# 也可用别名 GX_PUBLIC_ORIGIN（二者择一，CORS_ORIGIN 优先）。
# CORS_ORIGIN="http://localhost:5173"

# ── 监听（可选）──────────────────────────────────────────────────
# 端口默认 3001；生产建议由反代同机访问，应用仅绑回环。
PORT=3001

# ── 数据与上传目录（可选）────────────────────────────────────────
# GX_DATA_DIR：数据根目录。开发默认 apps/api；生产默认 /var/lib/gouxiangdb。
# UPLOAD_ROOT：头像/附件目录，默认 $GX_DATA_DIR/uploads（显式设置则优先）。
# GX_DATA_DIR=""
# UPLOAD_ROOT=""

# ── 健康检查 / readyz（可选）─────────────────────────────────────
# GX_MIGRATIONS_DIR：迁移目录，默认 apps/api/prisma/migrations（readyz 迁移对账用）。
# GX_MIN_DISK_MB：readyz 磁盘探针最低可用空间，默认 1024（MB）。
# GX_MIGRATIONS_DIR=""
# GX_MIN_DISK_MB=1024

# ── 审计日志（可选，S5c 启用）────────────────────────────────────
# 开发默认 $GX_DATA_DIR/.audit；生产默认 /var/log/gouxiangdb。
# GX_AUDIT_DIR=""

# ── 限流（可选，S5b 启用）────────────────────────────────────────
# on/off；默认 on，NODE_ENV=test 时默认 off（保证测试稳定）。
# GX_RATE_LIMIT="on"

# ── 备份（可选，S6 启用）─────────────────────────────────────────
# BACKUP_DIR：本地备份目录。开发默认 apps/api/.db-backups；生产默认 /var/backups/gouxiangdb。
# BACKUP_ENCRYPT_OFFSITE=true 时 AGE_RECIPIENT 必填（age X25519 公钥，age1...），
#   否则备份任务 fail-loud；解密 identity 私钥离线保管，绝不进本机环境文件。
# GX_OFFSITE_TARGET：异地通道（rclone remote / 挂载点）；未配则加密件停留本地 spool 并告警。
# BACKUP_DIR=""
# BACKUP_ENCRYPT_OFFSITE="true"
# AGE_RECIPIENT=""
# GX_OFFSITE_TARGET=""

# ── 测试/脚本专用（普通开发无需设置）────────────────────────────
# 置 1 时仅初始化路由不监听端口。
# GX_NO_LISTEN=0

# ── M5 统一检索 search.db / vec0（可选，默认 off；S2 起原生库就位）──
# GX_M5_SEARCH：统一检索总门，三态 off|shadow|on，默认 off；仅接受精确小写值，
#   未设置/空串/未知值/大写（如 ON）一律保守回 off。
#   off    = 不挂 /api/v1/search（请求落 v1 自身 404）、不起 indexer worker、
#            不建 search.db 连接，旧 /api/search 字节不变（两层门之一）。
#   shadow = 挂载 v1 search；S7 起新链路与旧 /api/search 对拍，结果只记日志不返回。
#   on     = 挂载 v1 search；S7 起新链路对外。
#   注意：/api/v1 整体仅在企业面（GX_ENTERPRISE_ORG/GX_ENTERPRISE_NAV）启用时挂载，
#   两企业 flag 全 off 时本开关单独 on 亦不可达。
# GX_M5_SEARCH="off"
# GX_SEARCH_DB_PATH：独立派生库文件（不经 Prisma、不进业务备份、可整文件删重建）。
#   默认 <GX_DATA_DIR>/search.db；需落在可写数据目录（非只读安装目录、非 NFS）。
# GX_SEARCH_DB_PATH=""
# GX_VEC_EXT_PATH：覆盖 vec0 动态库位置。可指向 vec0.<so|dylib|dll> 文件或其所在目录；
#   文件名恒为 vec0（改名会 dlsym 失败）。缺省时依次找 <appDir>/native/<triplet>/vec0.<ext>、
#   node_modules 平台子包。加载失败/平台不支持（如 musl/Alpine、32 位）自动降级纯 FTS/LIKE，
#   不阻断主服务启动。Docker 锁 node:22-bookworm（glibc），禁用 alpine。
# GX_VEC_EXT_PATH=""

# ── 离线同步服务端面（可选，默认 off；fail-closed）──────────────────
# GX_SYNC_SERVER：服务端同步能力总门，控制整组 /api/v1/sync/*（订阅/快照/拉/推/冲突/可见性）。
#   解析（configSync.ts parseSyncServerFlag）：trim+小写化后仅认 on|true|1 为开（大小写/首尾空白
#   不敏感，故 "ON"/" On " 也开）；未设置/空串/任何其它值（如 opn、yes、0）一律保守回 off。
#   off 时同步组首中间件在【任何 DB 访问之前】短路 404 SYNC_DISABLED，不写 sync_* 表、
#   不建额外连接，旧行为逐字节不变。per-request 读 env、不进启动冻结快照，改后无需重启即生效。
# 何时需要开：本实例要作为「被订阅的远端」，供桌面副本 / 其它节点拉推数据时。
#   - 桌面 dmg / 飞牛 fpk 产品形态已由壳与启动脚本默认通电（GX_SYNC_SERVER=on），无需在此手填；
#   - 裸机 systemd / Docker 自托管默认 off，需要同步服务端面时显式置 on。
#   副本（GX_OFFLINE_REPLICA=on 的纯客户端）一侧【不要】开本门：副本只发出站订阅，不开放被订阅面。
# GX_SYNC_SERVER="on"

# ── 应用版本更新机制（可选；全部留空即用默认值，不影响既有功能）──────────
# 设计：docs/design/2026-10-app-update/DESIGN.md。默认总开关 on，但只有工作区 owner
#   在「工作区设置 → 系统更新」手动点检查才会出网；不配置令牌时面板报「更新源尚未配置」。
# GX_UPDATE_ENABLED：总开关，默认 on；精确小写 "off" 关闭（路由 404、零出网）。
# GX_UPDATE_SOURCE：更新源 gitea（默认）| static（内网静态镜像，配 GX_UPDATE_MANIFEST_URL）。
# GX_UPDATE_TOKEN：更新源【只读】令牌（私有 Gitea release 资产鉴权，Authorization 头携带，
#   绝不进 URL/日志/浏览器；飞牛 fpk 由构建期 GX_READER_TOKEN 注入，无需手填）。
# GX_UPDATE_GITEA_BASE_URL：默认 https://gitea0.hn.takin.cc（仅 http/https）。
# GX_UPDATE_REPO：默认 GouXiang/gouxiangdb（owner/repo）。
# GX_UPDATE_CHANNEL：显式覆盖部署通道（一般不设，由部署形态自动识别为 fnos-fpk）。
# GX_UPDATE_ALLOW_PRERELEASE：精确小写 "on" 时把 rc 预发布纳入候选（演练/内测用，默认不纳入）。
# GX_UPDATE_TIMEOUT_MS=8000            # 清单/元数据请求超时
# GX_UPDATE_CACHE_TTL_MS=300000        # 清单进程内缓存 5 分钟
# GX_UPDATE_TICKET_TTL_MS=120000       # 下载票据有效期 2 分钟
# GX_UPDATE_DOWNLOAD_IDLE_TIMEOUT_MS=30000  # 下载流空闲超时（非总时长）
# GX_UPDATE_MANIFEST_URL：source=static 时的 update-manifest.json 直链。
