{
  "name": "@gx/api",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "bin": {
    "gx-mcp-stdio": "./dist/mcp-stdio.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/build.mjs",
    "smoke:dist": "node scripts/build.mjs && node scripts/smoke-dist.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 5",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "init:admin": "tsx scripts/init-admin.ts",
    "db:reset": "prisma migrate reset --force",
    "backup:online": "node scripts/backup/online-backup.mjs",
    "backup:verify": "node scripts/backup/verify-restore.mjs",
    "check:link-source": "node scripts/check-link-source-integrity.mjs"
  },
  "dependencies": {
    "@gx/blocks": "workspace:*",
    "@gx/canvas": "workspace:*",
    "@gx/design-tokens": "workspace:*",
    "@gx/shared-types": "workspace:*",
    "@hono/node-server": "^1.13.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.10.3",
    "jose": "^5.9.0",
    "ws": "8.21.3",
    "y-protocols": "1.0.7",
    "yjs": "13.6.32",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "@types/ws": "8",
    "esbuild": "0.28.2",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.5"
  },
  "optionalDependencies": {
    "sqlite-vec": "0.1.9"
  }
}
